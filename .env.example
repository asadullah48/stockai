# Optional: point InsightAgent at a local Ollama server for LLM-generated
# executive summaries. If unset (or Ollama isn't running), InsightAgent falls
# back to a deterministic rule-based template automatically - no key required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Set to "1" to force the rule-based template path even if Ollama is running
# (useful for CI, or for deterministic demo output).
OLLAMA_DISABLED=
